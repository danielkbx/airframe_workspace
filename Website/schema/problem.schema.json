{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airframe.app/schema/problem.schema.json",
  "title": "Airframe problem guide",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "status", "category", "order", "title", "summary", "questions", "viewPaths", "concepts", "blocks", "sources", "reviewedAgainst"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "review", "published"] },
    "category": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "questions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "viewPaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "concepts": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "blocks": { "type": "array", "items": { "$ref": "block.schema.json" } },
    "sources": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/source" } },
    "reviewedAgainst": { "$ref": "common.schema.json#/$defs/reviewedAgainst" }
  }
}
